<!-- The light Post-it palette: only brushes the main window always uses (including its
     scrollbars). Anything that uses Windows' own colours in light mode (menus, Settings, preview
     elements) is themed only in Dark.xaml. The exceptions, used in both themes, are
     SettingsWarningBrush (Settings' date example) and the PreviewCode*Brush syntax colours. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PostItBackgroundBrush" Color="#FFF3A3" />
    <SolidColorBrush x:Key="PostItToolbarBrush" Color="#FDEE8C" />
    <SolidColorBrush x:Key="PostItBorderBrush" Color="#E6D978" />
    <SolidColorBrush x:Key="PostItWindowBorderBrush" Color="#C9B44A" />
    <SolidColorBrush x:Key="PostItButtonBrush" Color="#FFE066" />
    <SolidColorBrush x:Key="PostItButtonHoverBrush" Color="#FFD633" />
    <SolidColorBrush x:Key="PostItButtonPressedBrush" Color="#F0C419" />
    <SolidColorBrush x:Key="PostItTextBrush" Color="#5C4F1A" />
    <SolidColorBrush x:Key="PostItCheckedTextBrush" Color="#5C4F1A" />
    <SolidColorBrush x:Key="PostItScrollThumbBrush" Color="#E6D978" />
    <SolidColorBrush x:Key="PostItScrollThumbHoverBrush" Color="#F0C419" />
    <SolidColorBrush x:Key="SettingsWarningBrush" Color="#A4262C" />

    <!-- Syntax colours for highlighted code in the preview: Visual Studio's light palette,
         darkened where needed to stay readable on Markdig.Wpf's grey (#D3D3D3) code background.
         MainWindow.HighlightCodeBlocks references "PreviewCode" + CodeTokenKind + "Brush". -->
    <SolidColorBrush x:Key="PreviewCodeKeywordBrush" Color="#0000FF" />
    <SolidColorBrush x:Key="PreviewCodeStringBrush" Color="#A31515" />
    <SolidColorBrush x:Key="PreviewCodeCommentBrush" Color="#006400" />
    <SolidColorBrush x:Key="PreviewCodeNumberBrush" Color="#05603F" />
    <SolidColorBrush x:Key="PreviewCodeTypeNameBrush" Color="#135A6E" />
    <SolidColorBrush x:Key="PreviewCodePreprocessorBrush" Color="#545454" />
    <SolidColorBrush x:Key="PreviewCodeMarkupDelimiterBrush" Color="#0000FF" />
    <SolidColorBrush x:Key="PreviewCodeMarkupElementBrush" Color="#800000" />
    <SolidColorBrush x:Key="PreviewCodeMarkupAttributeBrush" Color="#A00000" />
    <SolidColorBrush x:Key="PreviewCodeMarkupAttributeValueBrush" Color="#0000FF" />
    <SolidColorBrush x:Key="PreviewCodeMarkupEntityBrush" Color="#A00000" />
    <SolidColorBrush x:Key="PreviewCodeJsonKeyBrush" Color="#1C5490" />

    <!-- Keyboard-focus outline for the main window's Post-it buttons: an exact copy of the
         system (Aero2) one they showed before dark mode existed, so light looks unchanged. -->
    <Style x:Key="PostItFocusVisualStyle">
        <Setter Property="Control.Template">
            <Setter.Value>
                <ControlTemplate>
                    <Rectangle Margin="2" Stroke="{DynamicResource {x:Static SystemColors.ControlTextBrushKey}}" StrokeThickness="1" StrokeDashArray="1 2" SnapsToDevicePixels="True" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
</ResourceDictionary>
