<!-- The light Post-it palette: only brushes the main window always uses (including its
     scrollbars). Anything that uses Windows' own colours in light mode (menus, Settings, preview
     elements) is themed only in Dark.xaml. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <SolidColorBrush x:Key="PostItBackgroundBrush" Color="#FFF3A3" />
    <SolidColorBrush x:Key="PostItToolbarBrush" Color="#FDEE8C" />
    <SolidColorBrush x:Key="PostItBorderBrush" Color="#E6D978" />
    <SolidColorBrush x:Key="PostItButtonBrush" Color="#FFE066" />
    <SolidColorBrush x:Key="PostItButtonHoverBrush" Color="#FFD633" />
    <SolidColorBrush x:Key="PostItButtonPressedBrush" Color="#F0C419" />
    <SolidColorBrush x:Key="PostItTextBrush" Color="#5C4F1A" />
    <SolidColorBrush x:Key="PostItCheckedTextBrush" Color="#5C4F1A" />
    <SolidColorBrush x:Key="PostItScrollThumbBrush" Color="#E6D978" />
    <SolidColorBrush x:Key="PostItScrollThumbHoverBrush" Color="#F0C419" />
</ResourceDictionary>
