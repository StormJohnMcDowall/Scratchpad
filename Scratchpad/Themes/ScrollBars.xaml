<!-- Post-it scrollbars for both palettes: a full template, because the system one paints its
     own grey track. Keyed only — applied by an implicit ScrollBar style in MainWindow.xaml (both
     themes, main window only) and in Dark.xaml (everywhere in dark, e.g. Settings drop-downs).
     Colours come from each palette's brushes by DynamicResource, so they follow a theme switch. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style x:Key="PostItScrollArrowStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border x:Name="ArrowBorder" Background="Transparent">
                        <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ArrowBorder" Property="Background" Value="{DynamicResource PostItButtonBrush}" />
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False">
                            <Setter Property="Opacity" Value="0.4" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PostItScrollPageStyle" TargetType="{x:Type RepeatButton}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type RepeatButton}">
                    <Border Background="Transparent" />
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <Style x:Key="PostItScrollThumbStyle" TargetType="{x:Type Thumb}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="IsTabStop" Value="False" />
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="{x:Type Thumb}">
                    <Border x:Name="ThumbBorder" Background="{DynamicResource PostItScrollThumbBrush}" CornerRadius="4" Margin="3" />
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource PostItScrollThumbHoverBrush}" />
                        </Trigger>
                        <Trigger Property="IsDragging" Value="True">
                            <Setter TargetName="ThumbBorder" Property="Background" Value="{DynamicResource PostItScrollThumbHoverBrush}" />
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>

    <ControlTemplate x:Key="PostItVerticalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="{DynamicResource PostItBackgroundBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="14" />
                <RowDefinition Height="*" />
                <RowDefinition Height="14" />
            </Grid.RowDefinitions>
            <RepeatButton Grid.Row="0" Style="{StaticResource PostItScrollArrowStyle}" Command="ScrollBar.LineUpCommand">
                <Path Data="M 0 4 L 4 0 L 8 4 Z" Fill="{DynamicResource PostItTextBrush}" />
            </RepeatButton>
            <Track x:Name="PART_Track" Grid.Row="1" IsDirectionReversed="True">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource PostItScrollPageStyle}" Command="ScrollBar.PageUpCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource PostItScrollThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource PostItScrollPageStyle}" Command="ScrollBar.PageDownCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Row="2" Style="{StaticResource PostItScrollArrowStyle}" Command="ScrollBar.LineDownCommand">
                <Path Data="M 0 0 L 8 0 L 4 4 Z" Fill="{DynamicResource PostItTextBrush}" />
            </RepeatButton>
        </Grid>
    </ControlTemplate>

    <ControlTemplate x:Key="PostItHorizontalScrollBarTemplate" TargetType="{x:Type ScrollBar}">
        <Grid Background="{DynamicResource PostItBackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="14" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="14" />
            </Grid.ColumnDefinitions>
            <RepeatButton Grid.Column="0" Style="{StaticResource PostItScrollArrowStyle}" Command="ScrollBar.LineLeftCommand">
                <Path Data="M 4 0 L 0 4 L 4 8 Z" Fill="{DynamicResource PostItTextBrush}" />
            </RepeatButton>
            <Track x:Name="PART_Track" Grid.Column="1" IsDirectionReversed="False">
                <Track.DecreaseRepeatButton>
                    <RepeatButton Style="{StaticResource PostItScrollPageStyle}" Command="ScrollBar.PageLeftCommand" />
                </Track.DecreaseRepeatButton>
                <Track.Thumb>
                    <Thumb Style="{StaticResource PostItScrollThumbStyle}" />
                </Track.Thumb>
                <Track.IncreaseRepeatButton>
                    <RepeatButton Style="{StaticResource PostItScrollPageStyle}" Command="ScrollBar.PageRightCommand" />
                </Track.IncreaseRepeatButton>
            </Track>
            <RepeatButton Grid.Column="2" Style="{StaticResource PostItScrollArrowStyle}" Command="ScrollBar.LineRightCommand">
                <Path Data="M 0 0 L 4 4 L 0 8 Z" Fill="{DynamicResource PostItTextBrush}" />
            </RepeatButton>
        </Grid>
    </ControlTemplate>

    <Style x:Key="PostItScrollBarStyle" TargetType="{x:Type ScrollBar}">
        <Setter Property="Width" Value="14" />
        <Setter Property="Height" Value="Auto" />
        <Setter Property="Template" Value="{StaticResource PostItVerticalScrollBarTemplate}" />
        <Style.Triggers>
            <Trigger Property="Orientation" Value="Horizontal">
                <Setter Property="Width" Value="Auto" />
                <Setter Property="Height" Value="14" />
                <Setter Property="Template" Value="{StaticResource PostItHorizontalScrollBarTemplate}" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
