<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Scratchpad.Core\Scratchpad.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Markdig.Wpf" Version="0.5.0.1" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net48</TargetFramework>
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <UseWPF>true</UseWPF>
    <UseWindowsForms>true</UseWindowsForms>
    <ApplicationIcon>Assets\Scratchpad.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- Also a WPF resource: the windows' Icon and the tray icon load it by pack URI. -->
    <Resource Include="Assets\Scratchpad.ico" />
  </ItemGroup>

</Project>
