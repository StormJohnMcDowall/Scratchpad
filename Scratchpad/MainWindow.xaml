<Window x:Class="Scratchpad.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:markdig="clr-namespace:Markdig.Wpf;assembly=Markdig.Wpf"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Icon="pack://application:,,,/Assets/Scratchpad.ico"
        Title="Scratchpad" Width="420" Height="520" MinWidth="300" MinHeight="150"
        Background="{DynamicResource PostItBackgroundBrush}"
        BorderBrush="{DynamicResource PostItWindowBorderBrush}" BorderThickness="1"
        WindowStyle="None"
        Loaded="Window_Loaded" Closing="Window_Closing"
        StateChanged="Window_StateChanged"
        Activated="Window_Activated"
        PreviewKeyDown="Window_PreviewKeyDown"
        PreviewMouseLeftButtonDown="Window_PreviewMouseLeftButtonDown"
        PreviewMouseWheel="Window_PreviewMouseWheel">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="0" ResizeBorderThickness="6" GlassFrameThickness="0" UseAeroCaptionButtons="False" />
    </shell:WindowChrome.WindowChrome>
    <Window.Resources>
        <!-- Brushes live in Themes/Light.xaml / Themes/Dark.xaml (merged into App.Resources)
             and are referenced with DynamicResource so a theme switch re-colours live. -->
        <Style x:Key="PostItButtonBaseStyle" TargetType="{x:Type ButtonBase}">
            <Setter Property="FocusVisualStyle" Value="{DynamicResource PostItFocusVisualStyle}" />
            <Setter Property="Background" Value="{DynamicResource PostItButtonBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource PostItBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Foreground" Value="{DynamicResource PostItTextBrush}" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="{x:Type ButtonBase}">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="{TemplateBinding Padding}" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PostItButtonHoverBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Background" Value="{DynamicResource PostItButtonPressedBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
        <!-- Room around the note text, shared so the editor and preview line up. -->
        <Thickness x:Key="NoteTextPadding">10,8,10,8</Thickness>
        <Style TargetType="{x:Type ScrollBar}" BasedOn="{StaticResource PostItScrollBarStyle}" />
        <Style TargetType="{x:Type Button}" BasedOn="{StaticResource PostItButtonBaseStyle}" />
        <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource PostItButtonBaseStyle}">
            <Style.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter Property="Background" Value="{DynamicResource PostItButtonPressedBrush}" />
                    <Setter Property="Foreground" Value="{DynamicResource PostItCheckedTextBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <DockPanel>
        <Grid DockPanel.Dock="Top" Background="{DynamicResource PostItToolbarBrush}" MouseLeftButtonDown="Toolbar_MouseLeftButtonDown">
            <Grid.Resources>
                <!-- Icon buttons: glyphs from Windows' own icon font (Windows 10 and 11), each with
                     a tooltip naming it and its shortcut, and an accessible name for screen readers. -->
                <Style TargetType="{x:Type Button}" BasedOn="{StaticResource {x:Type Button}}">
                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="2,4" />
                </Style>
                <Style TargetType="{x:Type ToggleButton}" BasedOn="{StaticResource {x:Type ToggleButton}}">
                    <Setter Property="FontFamily" Value="Segoe MDL2 Assets" />
                    <Setter Property="FontSize" Value="14" />
                    <Setter Property="Width" Value="32" />
                    <Setter Property="Height" Value="28" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Margin" Value="2,4" />
                </Style>
            </Grid.Resources>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel Grid.Column="0" Orientation="Horizontal">
                <ToggleButton x:Name="PreviewToggleButton" Content="&#xE890;" Click="PreviewToggleButton_Click" ToolTip="Preview (Ctrl+E)" AutomationProperties.Name="Preview" />
                <ToggleButton x:Name="AlwaysOnTopToggleButton" Content="&#xE718;" Click="AlwaysOnTopToggleButton_Click" ToolTip="Always on top (Ctrl+T)" AutomationProperties.Name="Always on top" />
                <Button x:Name="PeekButton" Content="&#xE81E;" Click="PeekButton_Click" Focusable="False" ToolTip="Peek behind (Ctrl+Shift+click)" AutomationProperties.Name="Peek behind" />
                <Button x:Name="DateButton" Content="&#xE787;" Click="DateButton_Click" Focusable="False" ToolTip="Insert today's date (Ctrl+;)" AutomationProperties.Name="Insert date" />
                <Border Width="1" Margin="4,6" Background="{DynamicResource PostItBorderBrush}" />
                <Button x:Name="ZoomOutButton" Content="&#xE8E7;" Click="ZoomOutButton_Click" Focusable="False" ToolTip="Smaller text (Ctrl+-)" AutomationProperties.Name="Smaller text" />
                <Button x:Name="ZoomInButton" Content="&#xE8E8;" Click="ZoomInButton_Click" Focusable="False" ToolTip="Larger text (Ctrl++)" AutomationProperties.Name="Larger text" />
                <Button x:Name="SettingsButton" Content="&#xE713;" Click="SettingsButton_Click" Focusable="False" ToolTip="Settings" AutomationProperties.Name="Settings" />
            </StackPanel>
            <Button x:Name="HideButton" Grid.Column="2" Content="&#xE8BB;" FontSize="10" Click="HideButton_Click" Focusable="False" ToolTip="Hide to tray" AutomationProperties.Name="Hide to tray" />
        </Grid>
        <Grid>
            <TextBox x:Name="EditorTextBox"
                     AcceptsReturn="True"
                     AcceptsTab="True"
                     TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto"
                     Background="{DynamicResource PostItBackgroundBrush}"
                     Foreground="{DynamicResource PostItTextBrush}"
                     BorderThickness="0"
                     Padding="{StaticResource NoteTextPadding}"
                     TextChanged="EditorTextBox_TextChanged"
                     PreviewTextInput="EditorTextBox_PreviewTextInput"
                     PreviewMouseLeftButtonDown="EditorTextBox_PreviewMouseLeftButtonDown" />
            <ScrollViewer x:Name="PreviewScrollViewer" Visibility="Collapsed" MouseDoubleClick="PreviewScrollViewer_MouseDoubleClick" PreviewMouseWheel="PreviewScrollViewer_PreviewMouseWheel" Background="{DynamicResource PostItBackgroundBrush}">
                <!-- A margin on the viewer, not the ScrollViewer's Padding: it scrolls with the
                     content, so PreviewNavigator's extent coordinates still line up, and it sits
                     outside the zoom's LayoutTransform, so it stays the size of the editor's. -->
                <markdig:MarkdownViewer x:Name="PreviewViewer" Margin="{StaticResource NoteTextPadding}" />
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
