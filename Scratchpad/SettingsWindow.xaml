<Window x:Class="Scratchpad.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:core="clr-namespace:Scratchpad.Core;assembly=Scratchpad.Core"
        Icon="pack://application:,,,/Assets/Scratchpad.ico"
        Title="Settings" Width="360" Height="470">
    <!-- Rows in on-screen order, which is also the Tab order (a DockPanel needed the bottom-
         docked Reset button first, so Tab visited it before everything else). -->
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>
        <GroupBox Grid.Row="0" Header="Appearance" Margin="8,8,8,0">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Label Grid.Column="0" Content="Theme" VerticalAlignment="Center" />
                <ComboBox Grid.Column="1" x:Name="ThemeComboBox">
                    <ComboBoxItem Content="Follow Windows" Tag="{x:Static core:ThemePreference.FollowWindows}" />
                    <ComboBoxItem Content="Light" Tag="{x:Static core:ThemePreference.Light}" />
                    <ComboBoxItem Content="Dark" Tag="{x:Static core:ThemePreference.Dark}" />
                </ComboBox>
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="1" Header="Startup" Margin="8,8,8,0">
            <CheckBox x:Name="ShowOnStartupCheckBox" Content="Show the window when Scratchpad starts" Margin="8" />
        </GroupBox>
        <GroupBox Grid.Row="2" Header="Date" Margin="8,8,8,0">
            <Grid Margin="8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="100" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Label Grid.Column="0" Content="Format" VerticalAlignment="Center" />
                <TextBox Grid.Column="1" x:Name="DateFormatTextBox" VerticalContentAlignment="Center" Padding="2" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="DateExampleTextBlock" Margin="2,4,0,0" />
            </Grid>
        </GroupBox>
        <GroupBox Grid.Row="3" Header="Fonts" Margin="8">
            <StackPanel Margin="8">
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Editor" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="EditorFontComboBox" DisplayMemberPath="Source" />
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Preview text" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="PreviewNormalFontComboBox" DisplayMemberPath="Source" />
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Preview code" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="PreviewCodeFontComboBox" DisplayMemberPath="Source" />
                </Grid>
            </StackPanel>
        </GroupBox>
        <Button Grid.Row="4" x:Name="ResetButton" HorizontalAlignment="Right" Content="Reset to defaults" Click="ResetButton_Click" Padding="8,4" Margin="8,0,8,8" />
    </Grid>
</Window>
