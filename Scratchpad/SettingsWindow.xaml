<Window x:Class="Scratchpad.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" Width="360" Height="260">
    <DockPanel>
        <Button x:Name="ResetButton" DockPanel.Dock="Bottom" HorizontalAlignment="Right" Content="Reset to defaults" Click="ResetButton_Click" Padding="8,4" Margin="8,0,8,8" />
        <GroupBox Header="Fonts" Margin="8">
            <StackPanel Margin="8">
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Editor" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="EditorFontComboBox" DisplayMemberPath="Source" />
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Preview text" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="PreviewNormalFontComboBox" DisplayMemberPath="Source" />
                </Grid>
                <Grid Margin="0,4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="100" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <Label Grid.Column="0" Content="Preview code" VerticalAlignment="Center" />
                    <ComboBox Grid.Column="1" x:Name="PreviewCodeFontComboBox" DisplayMemberPath="Source" />
                </Grid>
            </StackPanel>
        </GroupBox>
    </DockPanel>
</Window>
